# Copy to `.env.native.local` (git-ignored) to build the store apps with purchases.
# These are RevenueCat's PUBLIC SDK keys (they start with `appl_` and `goog_`); they are
# meant to ship inside the app. Never put a RevenueCat secret key (`sk_...`) here.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Set to 1 to show the Premium screens and locks in a web build, to work on them in a
# browser. The published website leaves it unset: it is fully open and sells nothing.
# VITE_PAYWALL=1
